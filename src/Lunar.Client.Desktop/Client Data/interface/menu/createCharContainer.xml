<widgets>
  <label name="lblMenuTitle" font="interfaceFont" text="Selected Class: "
         x="-160" y="-100" />

  <slider name="charSelectionSlider" texture="/gfx/Interface/sliderContainer.png"
          control-texture="/gfx/Interface/sliderControl.png"
          x="-160" y="-75" pad-x="0" pad-y="-4" max-value="2" zorder="1" />

  <label name="charStatsHeaderLabel" font="interfaceFont" text="Class Stats:"
         color="White" x="-160" y="0" zorder="1" />

  <label name="charHealthLabel" font="interfaceFont" text="Health: 0/0"
         color="White" x="-160" y="45" zorder="1" />

  <label name="charStrengthLabel" font="interfaceFont" text="Strength: 0/0"
         color="White" x="-160" y="70" zorder="1" />

  <label name="charIntLabel" font="interfaceFont" text="Intelligence: 0/0"
         color="White" x="-160" y="95" zorder="1" />

  <label name="charDefLabel" font="interfaceFont" text="Defense: 0/0"
         color="White" x="-160" y="120" zorder="1" />

  <label name="charDexLabel" font="interfaceFont" text="Dexterity: 0/0"
         color="White" x="-160" y="145" zorder="1" />

  <picture name="picChar" x="-100" y="0" />
</widgets>
