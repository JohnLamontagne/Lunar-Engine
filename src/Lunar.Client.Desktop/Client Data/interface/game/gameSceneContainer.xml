<widgets>
  <button name="btnInventory" texture="gfx/Interface/menuButton.png"
          font="chatFont" text="Inventory" x="65%" y="93%" />

  <button name="btnLogout" texture="gfx/Interface/menuButton.png"
          font="chatFont" text="Logout" x="88%" y="93%" />

  <button name="btnCharacter" texture="gfx/Interface/menuButton.png"
          font="chatFont" text="Character" x="76.50%" y="93%" />

  <chatbox name="chatbox" texture="gfx/Interface/chat.png" font="chatFont"
           x="0.5%" y="62%" maxlines="12" pad-x="30" pad-y="223"
           visible="true" draggable="true">
    <textbox name="messageEntry" texture="gfx/Interface/textboxNormal.png"
             font="chatFont" x="17" y="100%" scale-x="1.6" scale-y="1"
             pad-x="12" pad-y="0" />
  </chatbox>

  <statusbar name="healthStatusBar" font="interfaceFont"
             back-sprite="gfx/Interface/statusBar.png"
             fill-sprite="gfx/Interface/healthFillSprite.png"
             color="Black" x="23%" y="3%" fill-x="7" fill-y="7"
             pad-x="7" pad-y="7" text="" />

  <statusbar name="manaStatusBar" font="interfaceFont"
             back-sprite="gfx/Interface/statusBar.png"
             fill-sprite="gfx/Interface/manaFillSprite.png"
             color="Black" x="45%" y="3%" fill-x="7" fill-y="7"
             pad-x="7" pad-y="7" text="" />

  <statusbar name="experienceBar" font="interfaceFont"
             back-sprite="gfx/Interface/experienceBar.png"
             fill-sprite="gfx/Interface/experiencePool.png"
             color="White" x="25%" y="0%" fill-x="8" fill-y="31" text="" />

  <label name="lblExperience" font="experienceFont" text="0000/0000"
         color="White" x="40%" y="2.5%" zorder="2" />
</widgets>
