<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Lunar.Server</RootNamespace>
    <AssemblyName>Lunar.Server</AssemblyName>
    <Authors>John Lamontagne</Authors>
    <Product>Lunar.Server</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net90" Version="1.7.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lunar.Core\Lunar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lunar.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything under Server Data is runtime content. The .cs files there are gameplay scripts
         compiled by the Roslyn ScriptHost at startup, so they must be copied, not compiled here. -->
    <Compile Remove="Server Data\**" />
    <None Include="Server Data\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
